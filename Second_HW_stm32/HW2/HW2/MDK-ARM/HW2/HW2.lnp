"hw2\stm32f1xx_hal.o"
"hw2\stm32f1xx_hal_rcc.o"
"hw2\stm32f1xx_hal_rcc_ex.o"
"hw2\stm32f1xx_hal_gpio.o"
"hw2\stm32f1xx_hal_dma.o"
"hw2\stm32f1xx_hal_cortex.o"
"hw2\stm32f1xx_hal_pwr.o"
