"hw3\stm32f1xx_hal_rcc.o"
"hw3\stm32f1xx_hal_rcc_ex.o"
"hw3\stm32f1xx_hal_gpio.o"
"hw3\stm32f1xx_hal_dma.o"
"hw3\stm32f1xx_hal_cortex.o"
"hw3\stm32f1xx_hal_pwr.o"
