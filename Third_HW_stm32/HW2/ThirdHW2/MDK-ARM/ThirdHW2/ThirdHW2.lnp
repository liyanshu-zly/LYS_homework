"thirdhw2\stm32f1xx_hal.o"
"thirdhw2\stm32f1xx_hal_rcc.o"
"thirdhw2\stm32f1xx_hal_rcc_ex.o"
"thirdhw2\stm32f1xx_hal_gpio.o"
"thirdhw2\stm32f1xx_hal_dma.o"
