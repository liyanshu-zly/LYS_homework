--cpu Cortex-M3
"fisthw2\startup_stm32f103xb.o"
"fisthw2\main.o"
"fisthw2\stm32f1xx_it.o"
"fisthw2\stm32f1xx_hal_msp.o"
"fisthw2\stm32f1xx_hal_gpio_ex.o"
"fisthw2\stm32f1xx_hal.o"
"fisthw2\stm32f1xx_hal_rcc.o"
"fisthw2\stm32f1xx_hal_rcc_ex.o"
"fisthw2\stm32f1xx_hal_gpio.o"
"fisthw2\stm32f1xx_hal_dma.o"
"fisthw2\stm32f1xx_hal_cortex.o"
"fisthw2\stm32f1xx_hal_pwr.o"
"fisthw2\stm32f1xx_hal_flash.o"
"fisthw2\stm32f1xx_hal_flash_ex.o"
"fisthw2\stm32f1xx_hal_exti.o"
"fisthw2\system_stm32f1xx.o"
--strict --scatter "fistHW2\fistHW2.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "fistHW2.map" -o fistHW2\fistHW2.axf