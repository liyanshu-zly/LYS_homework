--cpu Cortex-M3
"fisthw1\startup_stm32f103xb.o"
"fisthw1\main.o"
"fisthw1\stm32f1xx_it.o"
"fisthw1\stm32f1xx_hal_msp.o"
"fisthw1\stm32f1xx_hal_gpio_ex.o"
"fisthw1\stm32f1xx_hal.o"
"fisthw1\stm32f1xx_hal_rcc.o"
"fisthw1\stm32f1xx_hal_rcc_ex.o"
"fisthw1\stm32f1xx_hal_gpio.o"
"fisthw1\stm32f1xx_hal_dma.o"
"fisthw1\stm32f1xx_hal_cortex.o"
"fisthw1\stm32f1xx_hal_pwr.o"
"fisthw1\stm32f1xx_hal_flash.o"
